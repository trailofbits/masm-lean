private theorem curr_main_col_eq (r : AirRow) {i : Nat}
    (hi : i < MainWidth) {hj : i < MainWidth} :
    (if _h : True then r.curr ⟨i, hi⟩ else 0) = r.curr ⟨i, hj⟩ := by
  simp

private theorem next_main_col_eq (r : AirRow) {i : Nat}
    (hi : i < MainWidth) {hj : i < MainWidth} :
    (if _h : True then r.next ⟨i, hi⟩ else 0) = r.next ⟨i, hj⟩ := by
  simp

private theorem curr_stack_col_eq (r : AirRow) {k : Nat}
    (hk : 30 + k < MainWidth) {hj : 30 + k < MainWidth} :
    (if _h : 30 + k < MainWidth then r.curr ⟨30 + k, _h⟩ else 0) =
      r.curr ⟨30 + k, hj⟩ := by
  simp [hk]

private theorem next_stack_col_eq (r : AirRow) {k : Nat}
    (hk : 30 + k < MainWidth) {hj : 30 + k < MainWidth} :
    (if _h : 30 + k < MainWidth then r.next ⟨30 + k, _h⟩ else 0) =
      r.next ⟨30 + k, hj⟩ := by
  simp [hk]

private theorem curr_helper_col_eq (r : AirRow) {k : Nat}
    (hk : 16 + k < MainWidth) {hj : 16 + k < MainWidth} :
    (if _h : 16 + k < MainWidth then r.curr ⟨16 + k, _h⟩ else 0) =
      r.curr ⟨16 + k, hj⟩ := by
  simp [hk]


private theorem curr_stack_lit_eq (r : AirRow) {k i : Nat}
    (hki : 30 + k = i) {hk : 30 + k < MainWidth} {hi : i < MainWidth} :
    r.curr ⟨30 + k, hk⟩ = r.curr ⟨i, hi⟩ := by
  subst hki
  simp

private theorem next_stack_lit_eq (r : AirRow) {k i : Nat}
    (hki : 30 + k = i) {hk : 30 + k < MainWidth} {hi : i < MainWidth} :
    r.next ⟨30 + k, hk⟩ = r.next ⟨i, hi⟩ := by
  subst hki
  simp

private theorem curr_helper_lit_eq (r : AirRow) {k i : Nat}
    (hki : 16 + k = i) {hk : 16 + k < MainWidth} {hi : i < MainWidth} :
    r.curr ⟨16 + k, hk⟩ = r.curr ⟨i, hi⟩ := by
  subst hki
  simp

private theorem stackCryptoLowBit0Zero_rw (r : AirRow) (h : stackCryptoLowBit0Zero r) :
    r.curr ⟨7, Subsystems.StackCrypto.opBit0Col._proof_1⟩ = 0 := by
  simpa [stackCryptoLowBit0Zero] using h

private theorem stackCryptoLowBit1Zero_rw (r : AirRow) (h : stackCryptoLowBit1Zero r) :
    r.curr ⟨8, Subsystems.StackCrypto.opBit1Col._proof_1⟩ = 0 := by
  simpa [stackCryptoLowBit1Zero] using h

private theorem stackCryptoExtraCol0Eq_rw (r : AirRow) (h : stackCryptoExtraCol0Eq r) :
    r.curr ⟨28, h28⟩ =
      r.curr ⟨13, Subsystems.StackCrypto.opBit6Col._proof_1⟩ *
        (1 - r.curr ⟨12, Subsystems.StackCrypto.opBit5Col._proof_1⟩) *
        r.curr ⟨11, Subsystems.StackCrypto.opBit4Col._proof_1⟩ := by
  simpa [stackCryptoExtraCol0Eq] using h

private theorem stackCryptoExtraCol1Eq_rw (r : AirRow) (h : stackCryptoExtraCol1Eq r) :
    r.curr ⟨29, h29⟩ =
      r.curr ⟨13, Subsystems.StackCrypto.opBit6Col._proof_1⟩ *
        r.curr ⟨12, Subsystems.StackCrypto.opBit5Col._proof_1⟩ := by
  simpa [stackCryptoExtraCol1Eq] using h

