@[simp] theorem felt_ofNat_seven_eq : (Felt.ofNat 7 : Felt) = 7 := rfl
@[simp] theorem felt_ofNat_eight_eq : (Felt.ofNat 8 : Felt) = 8 := rfl

/-
The extracted stack-crypto selectors factor through decoder extra columns `e0`
and `e1`. The canonical subsystem expands those columns back into opcode-bit
products. For `CRYPTOSTREAM`, the symbolic selector also omits the low-bit
factors `(1 - b1)` and `(1 - b0)`. The bridge theorems below therefore carry
exactly the decoder-side hypotheses needed to identify the two presentations.
-/
private def stackCryptoLowBit0Zero (r : AirRow) : Prop :=
  r.curr ⟨7, by decide⟩ = 0

private def stackCryptoLowBit1Zero (r : AirRow) : Prop :=
  r.curr ⟨8, by decide⟩ = 0

private def stackCryptoExtraCol0Eq (r : AirRow) : Prop :=
  r.curr ⟨28, by decide⟩ =
    r.curr ⟨13, by decide⟩ * (1 - r.curr ⟨12, by decide⟩) * r.curr ⟨11, by decide⟩

private def stackCryptoExtraCol1Eq (r : AirRow) : Prop :=
  r.curr ⟨29, by decide⟩ = r.curr ⟨13, by decide⟩ * r.curr ⟨12, by decide⟩

