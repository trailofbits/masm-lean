    Subsystems.StackCrypto.s12,
    Subsystems.StackCrypto.s13,
    Subsystems.StackCrypto.s14,
    Subsystems.StackCrypto.s15,
    Subsystems.StackCrypto.s8Next,
    Subsystems.StackCrypto.s9Next,
    Subsystems.StackCrypto.s10Next,
    Subsystems.StackCrypto.s11Next,
    Subsystems.StackCrypto.s12Next,
    Subsystems.StackCrypto.s13Next,
    Subsystems.StackCrypto.s14Next,
    Subsystems.StackCrypto.s15Next,
    Subsystems.StackCrypto.s8Col,
    Subsystems.StackCrypto.s9Col,
    Subsystems.StackCrypto.s10Col,
    Subsystems.StackCrypto.s11Col,
    Subsystems.StackCrypto.s12Col,
    Subsystems.StackCrypto.s13Col,
    Subsystems.StackCrypto.s14Col,
    Subsystems.StackCrypto.s15Col,
    Subsystems.StackCrypto.oneMinus,
    Subsystems.StackCrypto.eight,
    toSymbolicFrame,
    FExpr.eval,
    Builder.whenTransition,
    Builder.gate,
    Builder.assertEq,
    Builder.assertZero,
    BaseConstraint.eval,
    BaseConstraint.expr,
    AirRow.boundary,
    AirRow.baseAt,
    AirRow.base,
    SymbolicFrame.colCurr,
    SymbolicFrame.s,
    SymbolicFrame.s',
    h9,
    h10,
    h11,
    h29
  ]
  rw [curr_main_col_eq (r := r) (i := 9) h9 (hj := Subsystems.StackCrypto.opBit2Col._proof_1),
      curr_main_col_eq (r := r) (i := 10) h10 (hj := Subsystems.StackCrypto.opBit3Col._proof_1),
      curr_main_col_eq (r := r) (i := 29) h29 (hj := by decide),
