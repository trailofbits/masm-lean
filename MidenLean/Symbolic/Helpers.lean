import MidenLean.Symbolic.Exec

/-!
# Per-instruction soundness helpers

Helper theorems for `execInstruction_sound` proving that each supported instruction's
symbolic execution is sound with respect to concrete execution.

Organized in three parts:
- **Shared helpers**: list and precondition lemmas used across proofs
- **Generated lemmas**: stack-only instructions, emitted by the `sound_stack_op`
  command from the operand count, the instruction and its concrete handler
- **Hand-written lemmas**: everything whose proof does not fit that template
  (indexed and word-wide stack access, static immediate bounds, conditional
  data flow, and the state-preserving `u32Assert*` family)
-/

namespace MidenLean.Symbolic

-- Shared helper lemmas

/-- File-local convenience wrapper around Mathlib's
    `List.getElem?_eq_some_iff` (use that lemma directly outside this file). -/
private theorem getElem?_some_lt {α : Type} (l : List α) (n : Nat) (v : α)
    (h : l[n]? = some v) : n < l.length :=
  List.getElem?_eq_some_iff.mp h |>.1

/-- File-local convenience wrapper around Mathlib's
    `List.getElem?_eq_some_iff` (use that lemma directly outside this file). -/
private theorem getElem_of_getElem?_some {α : Type} (l : List α) (n : Nat) (v : α)
    (h : l[n]? = some v) : l[n]'(getElem?_some_lt l n v h) = v := by
  have := List.getElem?_eq_getElem (getElem?_some_lt l n v h) (α := α)
  rw [this] at h; exact Option.some.inj h

theorem getElem?_map_append_left {α β : Type} (f : α → β)
    (l : List α) (rest : List β) (n : Nat) (hn : n < l.length) :
    (l.map f ++ rest)[n]? = some (f l[n]) := by
  rw [List.getElem?_append, if_pos (by simp; omega), List.getElem?_map,
      List.getElem?_eq_getElem (by omega)]
  rfl

theorem set_map_append_left {α β : Type} (f : α → β)
    (l : List α) (rest : List β) (n : Nat) (x : α) (hn : n < l.length) :
    (l.set n x).map f ++ rest = (l.map f ++ rest).set n (f x) := by
  rw [List.map_set, List.set_append, if_pos (by simp; omega)]

theorem eraseIdx_map_append_left {α β : Type} (f : α → β)
    (l : List α) (rest : List β) (n : Nat) (hn : n < l.length) :
    (l.map f ++ rest).eraseIdx n = (l.eraseIdx n).map f ++ rest := by
  rw [List.eraseIdx_append_of_lt_length (by simp; omega), List.eraseIdx_map]

theorem isBool_guard (x : Felt) (h : x = 0 ∨ x = 1) : x.isBool = true := by
  unfold Felt.isBool
  rcases h with rfl | rfl <;> decide

theorem map_lit_map_eval (σ : Assignment) (vs : List Felt) :
    (vs.map Expr.lit).map (Expr.eval σ) = vs := by
  induction vs with
  | nil => rfl
  | cons v rest ih => simp [Expr.eval, ih]

-- Helper: a = b → (a == b) = true for Felt
theorem feltEq_beq_guard (a b : Felt) (h : a = b) : ((a == b) = true) := by
  subst h
  simp

/-- Convert the symbolic `.nonzero` precondition (Felt BEq with 0 is false)
    to a Nat-level `val == 0 = false` fact usable in concrete guards. -/
theorem felt_nonzero_val_ne_zero {x : Felt}
    (h : ((x == (0 : Felt)) = false)) : ((x.val == 0) = false) := by
  simp only [beq_eq_false_iff_ne, ne_eq] at h ⊢
  intro hval
  apply h
  exact (ZMod.val_eq_zero x).mp hval

/-- For small n (n ≤ 31), (Felt.ofNat n).val = n. Used in Imm instruction proofs
    to bridge symbolic evaluation (which goes through .lit (Felt.ofNat n)) and
    concrete execution (which uses n directly). -/
theorem feltOfNat_val_small (n : Nat) (hn : n ≤ 31) :
    (Felt.ofNat n).val = n := by
  unfold Felt.ofNat
  simp only [Felt, GOLDILOCKS_PRIME]
  rw [ZMod.val_natCast]
  apply Nat.mod_eq_of_lt
  omega

/-! ## Generated per-instruction lemmas

Most supported instructions are *stack-only*: they pop a fixed number of
operands, push a symbolic result, and leave memory, frames and advice
untouched. All of those share a single proof, so they are generated by the
`sound_stack_op` command below instead of being spelled out one by one.

    sound_stack_op <operands popped> <name suffix> <instruction> <handler>
      [<handler arguments>] (using [<extra simp lemmas>])? (with <extra binders>)?

For example `sound_stack_op 2 lt .lt execLt` generates
`execInstruction_sound_lt`, and `sound_stack_op 1 divImm (.divImm v) execDivImm v
with (v : Felt)` generates `execInstruction_sound_divImm`. Statements are
identical to the hand-written ones (same name, same binder order), so
`Soundness.lean`'s dispatcher calls them positionally as before.

The four `macro_rules` differ only in the stack pattern they match — one per
supported operand count. Instructions needing a different proof shape (indexed
stack access, static immediate bounds, conditional data flow, or the
state-preserving `u32Assert*` family) are written out by hand below.
-/

/-- The shared soundness step for stack-only instructions: given that the
    symbolic step only rewrote the stack to `stk`, the concrete successor is
    `cs.withStack (stk.map (Expr.eval σ) ++ rest)`, and every non-stack
    component of `models` is inherited from `hmodels`. -/
theorem sound_withStack {i : Instruction} {ss : State} {stk : List Expr}
    {cs : Concrete.State} {σ : Assignment} {rest : List Felt}
    (hmodels : ss.models cs σ rest)
    (hc : MidenLean.execInstruction cs i
        = some (cs.withStack (stk.map (Expr.eval σ) ++ rest))) :
    ∃ cs', MidenLean.execInstruction cs i = some cs' ∧
      ({ ss with stack := stk } : State).models cs' σ rest := by
  obtain ⟨_, hmem, hframes, hadv⟩ := hmodels
  exact ⟨_, hc, rfl, hmem, hframes, hadv⟩

/-- Bridge a `.valLeq` precondition to the `>` guard of a concrete handler.
    Stated as a `= False` rewrite so `simp` can discharge the guard. -/
theorem lt_val_eq_false_of_le {x : Felt} {n : Nat} (h : x.val ≤ n) :
    (n < x.val) = False := by simp; omega

open Lean Parser.Tactic in
/-- See the section comment above. -/
local syntax "sound_stack_op " num ident term:max ident (ppSpace term:max)*
    (" using " "[" simpLemma,* "]")? (" with " bracketedBinder+)? : command

-- The three `try` steps cover the optional parts of the template: instructions
-- without preconditions have nothing to normalise in `hpreconds`, `simp` closes
-- most concrete goals outright, and the trailing `rfl` absorbs handlers written
-- with a definitionally equal operation (`&&&` versus `Nat.land`, say). A step
-- that genuinely fails leaves its goal open, so the theorem still fails loudly.
macro_rules
  | `(sound_stack_op 1 $suffix:ident $instr:term $ec:ident $args:term*
        $[using [$extras,*]]? $[with $binders*]?) => do
    let name := Lean.mkIdentFrom suffix
      (Lean.Name.mkSimple ("execInstruction_sound_" ++ suffix.getId.toString))
    let extras := extras.getD ⟨#[]⟩
    let binders := binders.getD #[]
    `(theorem $name $binders* (ss : State) (cs : Concrete.State)
          (σ : Assignment) (rest : List Felt)
          (ss' : State) (preconds : List Precondition)
          (hmodels : ss.models cs σ rest)
          (hexec : execInstruction ss $instr = some (ss', preconds))
          (hpreconds : ∀ p ∈ preconds, p.holds σ) :
          ∃ cs', MidenLean.execInstruction cs $instr = some cs' ∧
            ss'.models cs' σ rest := by
        simp only [execInstruction] at hexec
        match hstk : ss.stack with
        | [] => simp [hstk] at hexec
        | e₁ :: tail =>
          simp only [hstk] at hexec
          obtain ⟨hss, hpre⟩ := Prod.mk.inj (Option.some.inj hexec)
          subst hss
          subst hpre
          refine sound_withStack hmodels ?_
          obtain ⟨hstack, -, -, -⟩ := hmodels
          rw [hstk] at hstack
          try simp only [List.forall_mem_cons, List.not_mem_nil, false_implies,
            implies_true, and_true, Precondition.holds, Expr.eval] at hpreconds
          change $ec $args* cs = _
          unfold $ec
          rw [hstack]
          try simp [*, Concrete.State.withStack, Expr.eval, isBool_guard,
            felt_nonzero_val_ne_zero, lt_val_eq_false_of_le, ZMod.val_zero,
            ZMod.val_one, $extras,*]
          try rfl)
  | `(sound_stack_op 2 $suffix:ident $instr:term $ec:ident $args:term*
        $[using [$extras,*]]? $[with $binders*]?) => do
    let name := Lean.mkIdentFrom suffix
      (Lean.Name.mkSimple ("execInstruction_sound_" ++ suffix.getId.toString))
    let extras := extras.getD ⟨#[]⟩
    let binders := binders.getD #[]
    `(theorem $name $binders* (ss : State) (cs : Concrete.State)
          (σ : Assignment) (rest : List Felt)
          (ss' : State) (preconds : List Precondition)
          (hmodels : ss.models cs σ rest)
          (hexec : execInstruction ss $instr = some (ss', preconds))
          (hpreconds : ∀ p ∈ preconds, p.holds σ) :
          ∃ cs', MidenLean.execInstruction cs $instr = some cs' ∧
            ss'.models cs' σ rest := by
        simp only [execInstruction] at hexec
        match hstk : ss.stack with
        | [] | [_] => simp [hstk] at hexec
        | e₁ :: e₂ :: tail =>
          simp only [hstk] at hexec
          obtain ⟨hss, hpre⟩ := Prod.mk.inj (Option.some.inj hexec)
          subst hss
          subst hpre
          refine sound_withStack hmodels ?_
          obtain ⟨hstack, -, -, -⟩ := hmodels
          rw [hstk] at hstack
          try simp only [List.forall_mem_cons, List.not_mem_nil, false_implies,
            implies_true, and_true, Precondition.holds, Expr.eval] at hpreconds
          change $ec $args* cs = _
          unfold $ec
          rw [hstack]
          try simp [*, Concrete.State.withStack, Expr.eval, isBool_guard,
            felt_nonzero_val_ne_zero, lt_val_eq_false_of_le, ZMod.val_zero,
            ZMod.val_one, $extras,*]
          try rfl)
  | `(sound_stack_op 3 $suffix:ident $instr:term $ec:ident $args:term*
        $[using [$extras,*]]? $[with $binders*]?) => do
    let name := Lean.mkIdentFrom suffix
      (Lean.Name.mkSimple ("execInstruction_sound_" ++ suffix.getId.toString))
    let extras := extras.getD ⟨#[]⟩
    let binders := binders.getD #[]
    `(theorem $name $binders* (ss : State) (cs : Concrete.State)
          (σ : Assignment) (rest : List Felt)
          (ss' : State) (preconds : List Precondition)
          (hmodels : ss.models cs σ rest)
          (hexec : execInstruction ss $instr = some (ss', preconds))
          (hpreconds : ∀ p ∈ preconds, p.holds σ) :
          ∃ cs', MidenLean.execInstruction cs $instr = some cs' ∧
            ss'.models cs' σ rest := by
        simp only [execInstruction] at hexec
        match hstk : ss.stack with
        | [] | [_] | [_, _] => simp [hstk] at hexec
        | e₁ :: e₂ :: e₃ :: tail =>
          simp only [hstk] at hexec
          obtain ⟨hss, hpre⟩ := Prod.mk.inj (Option.some.inj hexec)
          subst hss
          subst hpre
          refine sound_withStack hmodels ?_
          obtain ⟨hstack, -, -, -⟩ := hmodels
          rw [hstk] at hstack
          try simp only [List.forall_mem_cons, List.not_mem_nil, false_implies,
            implies_true, and_true, Precondition.holds, Expr.eval] at hpreconds
          change $ec $args* cs = _
          unfold $ec
          rw [hstack]
          try simp [*, Concrete.State.withStack, Expr.eval, isBool_guard,
            felt_nonzero_val_ne_zero, lt_val_eq_false_of_le, ZMod.val_zero,
            ZMod.val_one, $extras,*]
          try rfl)
  | `(sound_stack_op 4 $suffix:ident $instr:term $ec:ident $args:term*
        $[using [$extras,*]]? $[with $binders*]?) => do
    let name := Lean.mkIdentFrom suffix
      (Lean.Name.mkSimple ("execInstruction_sound_" ++ suffix.getId.toString))
    let extras := extras.getD ⟨#[]⟩
    let binders := binders.getD #[]
    `(theorem $name $binders* (ss : State) (cs : Concrete.State)
          (σ : Assignment) (rest : List Felt)
          (ss' : State) (preconds : List Precondition)
          (hmodels : ss.models cs σ rest)
          (hexec : execInstruction ss $instr = some (ss', preconds))
          (hpreconds : ∀ p ∈ preconds, p.holds σ) :
          ∃ cs', MidenLean.execInstruction cs $instr = some cs' ∧
            ss'.models cs' σ rest := by
        simp only [execInstruction] at hexec
        match hstk : ss.stack with
        | [] | [_] | [_, _] | [_, _, _] => simp [hstk] at hexec
        | e₁ :: e₂ :: e₃ :: e₄ :: tail =>
          simp only [hstk] at hexec
          obtain ⟨hss, hpre⟩ := Prod.mk.inj (Option.some.inj hexec)
          subst hss
          subst hpre
          refine sound_withStack hmodels ?_
          obtain ⟨hstack, -, -, -⟩ := hmodels
          rw [hstk] at hstack
          try simp only [List.forall_mem_cons, List.not_mem_nil, false_implies,
            implies_true, and_true, Precondition.holds, Expr.eval] at hpreconds
          change $ec $args* cs = _
          unfold $ec
          rw [hstack]
          try simp [*, Concrete.State.withStack, Expr.eval, isBool_guard,
            felt_nonzero_val_ne_zero, lt_val_eq_false_of_le, ZMod.val_zero,
            ZMod.val_one, $extras,*]
          try rfl)


-- Field arithmetic (single operand)
sound_stack_op 1 neg .neg execNeg
sound_stack_op 1 incr .incr execIncr
sound_stack_op 1 inv .inv execInv
sound_stack_op 1 pow2 .pow2 execPow2
sound_stack_op 1 isOdd .isOdd execIsOdd
sound_stack_op 1 not .not execNot

-- Field arithmetic and comparison with an immediate
sound_stack_op 1 addImm (.addImm v) execAddImm v with (v : Felt)
sound_stack_op 1 subImm (.subImm v) execSubImm v with (v : Felt)
sound_stack_op 1 mulImm (.mulImm v) execMulImm v with (v : Felt)
sound_stack_op 1 divImm (.divImm v) execDivImm v with (v : Felt)
sound_stack_op 1 eqImm (.eqImm v) execEqImm v with (v : Felt)
sound_stack_op 1 neqImm (.neqImm v) execNeqImm v with (v : Felt)

-- Field comparison and boolean (two operands)
sound_stack_op 2 neq .neq execNeq
sound_stack_op 2 lt .lt execLt
sound_stack_op 2 lte .lte execLte
sound_stack_op 2 gt .gt execGt
sound_stack_op 2 gte .gte execGte
sound_stack_op 2 or .or execOr
sound_stack_op 2 xor .xor execXor
sound_stack_op 2 div .div execDiv

-- Assertions
sound_stack_op 1 assert .assert execAssert
sound_stack_op 1 assertWithError (.assertWithError msg) execAssert with (msg : String)
sound_stack_op 1 assertz .assertz execAssertz
sound_stack_op 1 assertzWithError (.assertzWithError msg) execAssertz with (msg : String)
sound_stack_op 2 assertEq .assertEq execAssertEq
sound_stack_op 2 assertEqWithError (.assertEqWithError msg) execAssertEq with (msg : String)

-- U32 conversion and tests
