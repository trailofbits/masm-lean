sound_stack_op 2 u32WrappingMul .u32WrappingMul execU32WrappingMul using [u32Max]
sound_stack_op 3 u32WidenMadd .u32WidenMadd execU32WidenMadd using [u32WideMadd]
sound_stack_op 3 u32WrappingMadd .u32WrappingMadd execU32WrappingMadd using [u32Max]
sound_stack_op 2 u32DivMod .u32DivMod execU32DivMod
sound_stack_op 2 u32Div .u32Div execU32Div
sound_stack_op 2 u32Mod .u32Mod execU32Mod

-- U32 bitwise and unary
sound_stack_op 2 u32And .u32And execU32And
sound_stack_op 2 u32Or .u32Or execU32Or
sound_stack_op 2 u32Xor .u32Xor execU32Xor
sound_stack_op 1 u32Not .u32Not execU32Not
sound_stack_op 1 u32Popcnt .u32Popcnt execU32Popcnt
sound_stack_op 1 u32Clz .u32Clz execU32Clz
sound_stack_op 1 u32Ctz .u32Ctz execU32Ctz
sound_stack_op 1 u32Clo .u32Clo execU32Clo
